# BisaPrint — Environment Variables
# Copy this file to .env.local and fill in the values.

NEXT_PUBLIC_WHATSAPP_NUMBER="6281299435019"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin notifications (WA admin click-to-chat)
ADMIN_WHATSAPP_NUMBER="6281299435019"

# Optional outbound webhook for real-time admin alerts (n8n/Make/Telegram/Discord).
# If empty, notifications are only logged server-side.
ADMIN_NOTIFY_WEBHOOK_URL=""

# Admin dashboard (/admin + /api/admin) — HTTP Basic Auth.
# REQUIRED: if either is empty, all admin routes return 401 (fail-closed).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Midtrans payment
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Order persistence (required for production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File uploads (required for production)
BLOB_READ_WRITE_TOKEN=""

# Tracking
META_PIXEL_ID=""
GOOGLE_ANALYTICS_ID=""

# Google Search Console verification (optional — meta tag omitted if empty)
GOOGLE_SITE_VERIFICATION=""
