# BisaPrint — Environment Variables
# Copy this file to .env.local and fill in the values.

NEXT_PUBLIC_WHATSAPP_NUMBER="6281299435019"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin notifications (WA admin click-to-chat)
ADMIN_WHATSAPP_NUMBER="6281299435019"

# Optional outbound webhook for real-time admin alerts (n8n/Make/Telegram/Discord).
# If empty, notifications are only logged server-side.
ADMIN_NOTIFY_WEBHOOK_URL=""

# Admin dashboard (/admin + /api/admin) — HTTP Basic Auth.
# REQUIRED: if either is empty, all admin routes return 401 (fail-closed).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Midtrans payment
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Order persistence (required for production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File uploads (required for production) — Upstash Blob private bucket.
# Admin membaca file via signed URL redirect di /api/admin/files.
# Kosong = fallback data-URL lokal (dev saja; file tidak persist).
UPSTASH_BLOB_TOKEN=""

# Draft AI designer di /simulator — kalau diisi pakai OpenAI Images API
# (gpt-image-1, berbayar per image, quality=low ≈ $0.02/image).
# Kosongkan → fallback Pollinations (gratis, tanpa key, bisa antre ~1 menit).
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Tracking
META_PIXEL_ID=""
GOOGLE_ANALYTICS_ID=""

# Google Search Console verification (optional — meta tag omitted if empty)
GOOGLE_SITE_VERIFICATION=""
